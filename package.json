{
  "name": "octocode-agent-monorepo",
  "version": "1.0.0",
  "description": "Octocode agent monorepo — the branded agent launcher, the Pi harness extension, and the Awareness coordination layer.",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": "bgauryy/octocode-agent.git",
  "bugs": "https://github.com/bgauryy/octocode-agent/issues",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "lint": "yarn workspaces foreach -At run lint",
    "lint:fix": "yarn workspaces foreach -At run lint:fix",
    "test": "yarn workspaces foreach -At run test",
    "test:ffi": "yarn workspace octocode-agent test:ffi",
    "test:pack": "yarn workspace octocode-agent test:pack",
    "test:pty": "yarn workspace octocode-agent test:pty",
    "test:pty:stream": "yarn workspace octocode-agent test:pty:stream",
    "test:pty:signals": "yarn workspace octocode-agent test:pty:signals",
    "test:performance": "yarn workspace octocode-agent test:performance",
    "test:performance:guarded": "yarn workspace octocode-agent test:performance:guarded",
    "test:quiet": "yarn workspaces foreach -At run test:quiet",
    "typecheck": "yarn workspaces foreach -At run typecheck && yarn workspace octocode-agent typecheck:tests",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn test:ffi && yarn build && yarn test:pack && yarn test:pty && yarn test:pty:stream && yarn test:pty:signals && yarn test:performance:guarded"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
