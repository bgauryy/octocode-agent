{
  "name": "@octocodeai/octocode-awareness-lite",
  "version": "0.1.0",
  "description": "Tiny local SQLite coordination for coding agents: plans, tasks, locks, checks, and memory.",
  "keywords": [
    "octocode",
    "awareness",
    "sqlite",
    "plans",
    "tasks",
    "locks",
    "agent"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-agent.git",
    "directory": "packages/octocode-awareness-lite"
  },
  "bugs": "https://github.com/bgauryy/octocode-agent/issues",
  "license": "MIT",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "default": "./out/index.js"
    }
  },
  "bin": "./out/cli.js",
  "files": [
    "out/**",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf out/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
