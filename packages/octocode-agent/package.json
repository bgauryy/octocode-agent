{
  "name": "octocode-agent",
  "version": "1.1.0",
  "description": "Native Octocode coding-agent runtime, transports, OpenTUI terminal, sessions, and settings — one branded command and no native Pi dependency.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "native-agent",
    "agent",
    "cli"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-agent"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "bin": "./out/octocode-agent.mjs",
  "files": [
    "out/**",
    "docs/**",
    "!docs/PI_INTEGRATION.md",
    "!docs/pi-fork.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@ai-sdk/anthropic": "4.0.45",
    "@ai-sdk/openai": "4.0.51",
    "@ai-sdk/openai-compatible": "3.0.40",
    "@modelcontextprotocol/client": "2.0.0",
    "@octocodeai/config": "18.0.1",
    "@octocodeai/octocode-awareness": "1.4.0",
    "@opentui/core": "0.5.8",
    "ai": "7.0.84",
    "ajv": "8.20.0",
    "octocode": "18.3.0",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@octocodeai/agent-core": "0.1.0",
    "@octocodeai/octocode-shared": "0.1.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "start": "node ./out/octocode-agent.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:ffi": "node --experimental-ffi ../../node_modules/vitest/vitest.mjs run",
    "test:opentui:ffi": "node --experimental-ffi ../../node_modules/vitest/vitest.mjs run opentui",
    "test:pack": "node tests/package-install-smoke.mjs",
    "test:pty": "node tests/run-opentui-pty-smoke.mjs",
    "test:pty:stream": "node tests/run-opentui-pty-smoke.mjs opentui-pty-stream.mjs",
    "test:pty:signals": "node tests/opentui-cli-signal-smoke.mjs",
    "test:performance": "node --experimental-ffi --import tsx tests/opentui-performance.mjs",
    "test:performance:guarded": "OCTOCODE_TUI_MAX_FIRST_RENDER_MS=1000 OCTOCODE_TUI_MAX_STREAM_MS=2000 OCTOCODE_TUI_MAX_RESIZE_MS=1000 OCTOCODE_TUI_MAX_SHUTDOWN_MS=500 OCTOCODE_TUI_MAX_PEAK_RSS_BYTES=1073741824 node --experimental-ffi --import tsx tests/opentui-performance.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "yarn typecheck && yarn typecheck:tests && yarn test:ffi && yarn build && yarn test:pack && yarn test:pty && yarn test:pty:stream && yarn test:pty:signals && yarn test:performance:guarded",
    "check:no-native-pi": "node scripts/check-no-native-pi.mjs",
    "check:no-workspace": "node scripts/check-no-workspace-protocol.mjs",
    "sync:version:publish": "node scripts/sync-version.mjs",
    "prepack": "node scripts/check-no-workspace-protocol.mjs && yarn workspace @octocodeai/agent-core build && yarn workspace @octocodeai/octocode-shared build && yarn build && yarn check:no-native-pi",
    "prepublishOnly": "node scripts/check-no-workspace-protocol.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "octocode": {
    "readmeSync": false
  }
}
