{
  "name": "octocode-agent",
  "version": "1.0.2",
  "description": "Self-working coding agent platform: launches Pi with the Octocode harness (@octocodeai/pi-extension) as its core — one branded command, one update path.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "pi",
    "agent",
    "cli"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-agent"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "bin": "./bin/octocode-agent.mjs",
  "exports": {
    ".": {
      "types": "./out/launcher.d.ts",
      "import": "./out/launcher.js",
      "default": "./out/launcher.js"
    },
    "./launcher": {
      "types": "./out/launcher.d.ts",
      "import": "./out/launcher.js",
      "default": "./out/launcher.js"
    },
    "./sdk-launcher": {
      "types": "./out/sdk-launcher.d.ts",
      "import": "./out/sdk-launcher.js",
      "default": "./out/sdk-launcher.js"
    }
  },
  "files": [
    "bin/**",
    "out/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@octocodeai/config": "^17.0.1",
    "@octocodeai/pi-extension": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./bin/octocode-agent.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "yarn typecheck && yarn test",
    "check:no-workspace": "node scripts/check-no-workspace-protocol.mjs",
    "prepack": "node scripts/check-no-workspace-protocol.mjs && yarn build",
    "prepublishOnly": "node scripts/check-no-workspace-protocol.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "octocode": {
    "readmeSync": false
  }
}
